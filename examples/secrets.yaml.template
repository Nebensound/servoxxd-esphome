# ESPHome Secrets Template for Examples
# Copy this file to secrets.yaml and fill in your actual credentials
# secrets.yaml is in .gitignore and will not be committed to git

# WiFi credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Generate a private key for your device; this public placeholder is for validation only.
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# OTA update password (optional but recommended)
ota_password: "YourOTAPassword"

# Fallback AP password
fallback_ap_password: "fallback123"
